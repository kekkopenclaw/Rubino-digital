# .env.example — EVERY swappable variable. Copy to .env for local dev.
# Placeholders only — NO real secrets here.
# In production, set these as environment variables in Azure / Render, not in a file.

# --- Runtime ---
ASPNETCORE_ENVIRONMENT=Development
PORT=5000

# --- JWT (generate a long random value for production, 32+ chars) ---
Jwt__Key=DEV-ONLY-change-me-in-production-use-a-long-random-secret-at-least-32-chars
Jwt__Issuer=RubinoDigital.Api
Jwt__AccessExpiryMinutes=15
Jwt__RefreshExpiryDays=7

# --- Frontend origin (CORS is locked to this) ---
Frontend__Origin=http://localhost:4200

# --- Agency inbox (blank by default — no email is invented) ---
Agency__Email=

# --- Stripe — TEST-MODE STUB by default (no live keys, no payment taken) ---
# Free Stripe account, test mode: sk_test_… / pk_test_…
Stripe__SecretKey=sk_test_
Stripe__PublishableKey=pk_test_
Stripe__WebhookSecret=whsec_

# --- Email — Log provider in dev (no real emails sent) ---
# Options: Log (dev), Resend (free 100/day), SendGrid (free 100/day).
Email__Provider=Log
Email__ApiKey=
Email__From=hello@rubinodigital.example

# --- Database — SQLite by default (free) ---
ConnectionStrings__DefaultConnection=Data Source=rubinodigital.db
